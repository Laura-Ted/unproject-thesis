{
  "name": "unproject",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @unproject/web dev",
    "build": "pnpm -r build",
    "compile": "pnpm -r compile",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\"",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
